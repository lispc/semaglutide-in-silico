# tleap for exp-D: no_linker (rebuild 2026-07-17)
source leaprc.protein.ff14SB
source leaprc.gaff2
source leaprc.water.tip3p
loadAmberParams frcmod.ionsjc_tip3p
loadAmberParams lya_link.frcmod
loadAmberParams lya_link_c8.frcmod

# Rebuilt LNK (structure-aware strip, full bond table, GAFF2 types)
LNK = loadMol2 lnk_no_linker_clean.mol2
prot = loadPdb ecd_pep_nocap.pdb
complex = combine { prot LNK }

# Deprotonate Lys26 NZ and form NZ-C11 amide bond (Lys26 = residue 117,
# LNK = residue 127). tleap bond/remove have a documented silent-failure
# bug -> verified and repaired with ParmEd in fix_prmtop_bonds.py
remove complex complex.117.HZ1
remove complex complex.117.HZ2
remove complex complex.117.HZ3
bond complex.117.NZ complex.127.C11

solvateOct complex TIP3PBOX 10.0
addIons complex Na+ 0
addIons complex Cl- 0

check complex
saveAmberParm complex no_linker.prmtop no_linker.inpcrd
savePdb complex no_linker_solvated.pdb
quit
