; Energy minimization for membrane system
integrator      = steep
nsteps           = 5000
emtol           = 100.0
emstep          = 0.01
nstxout         = 0
cutoff-scheme   = Verlet
coulombtype     = PME
rcoulomb        = 1.0
vdwtype         = Cut-off
rvdw            = 1.0
pbc             = xyz
constraints     = h-bonds
constraint-algorithm = LINCS
lincs_iter      = 2
lincs_order     = 6
